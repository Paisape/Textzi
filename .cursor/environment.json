{
  "name": "Textzi",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd apps/api && /workspace/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "web",
      "command": "cd apps/web && pnpm dev --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    },
    {
      "name": "web",
      "port": 5173
    }
  ]
}
