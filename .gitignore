.env
.env.bak

# Claude Code's own local settings -- has held real secrets/credentials in its permission-
# allowlist history in this project before (curl commands with real admin keys/passwords baked
# in) -- never commit this directory.
.claude/
__pycache__/
*.py[cod]
.venv/
node_modules/
.pnpm-store/
dist/
.pytest_cache/

# Purchased theme source (licensed reference material, not part of the deployed app --
# apps/web was built FROM this, not on top of it at runtime)
/Theme/
*.zip

# Local uploads (real deployments use the uploads_data Docker volume, never committed)
uploads/

# Stalwart writes its own generated config (DKIM keys, admin session tokens, the post-wizard
# config.json) into this directory at runtime -- never commit it. The one seed file we do want
# tracked (ops/stalwart-etc/config.json, which only pre-selects RocksDB as the datastore) is
# re-added via the negation pattern below.
ops/stalwart-etc/*
!ops/stalwart-etc/config.json

# Business/product docs -- kept locally, left out of the repo by default (unclear if this repo
# will end up public); ask to include them if you want them versioned too.
/*.docx
*.md

# Stray local logs / OS / editor cruft
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
