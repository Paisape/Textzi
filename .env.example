# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# ENVIRONMENT controls dev-only behavior across the app: OTP/invite codes are echoed back in API
# responses (dev_email_code, dev_mobile_code, dev_otp_code, dev_invite_token, dev_note) so the
# platform is testable without a real email/SMS provider, and the admin bootstrap key/worker key
# are allowed to stay at their placeholder values. Set this to "production" for any real
# deployment -- the app will refuse to start in production if JWT_SECRET or PROVIDER_SECRET_KEY
# are still at their placeholder values (see app/config.py), and every dev_* echo field above
# will stop appearing.
ENVIRONMENT=development

# --- Database ---
POSTGRES_DB=textzi
POSTGRES_USER=textzi
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://textzi:change-me-in-production@postgres:5432/textzi

# --- Redis (SMS rate limiting) & RabbitMQ (provisioned, not yet consumed by any code) ---
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Secrets -- every one of these MUST be a real, unique value outside development ---
# Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_KEY=replace-with-a-separate-long-random-admin-key
WORKER_KEY=replace-with-a-separate-long-random-worker-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Protects every encrypted secret in the system (provider credentials, SMTP password, 2FA TOTP
# secrets, encrypted message content/recipients) -- back this up somewhere safe; losing it means
# losing access to everything it encrypted.
PROVIDER_SECRET_KEY=replace-with-a-generated-fernet-key

# --- Public-facing URLs -- set these to your real domains outside development ---
# The frontend origin allowed to call this API (CORS).
WEB_ORIGIN=https://app.textzi.in
# This API's own externally-reachable base URL, used to build the delivery-report webhook URL
# providers call back on. Leave blank to simply not request delivery-report webhooks.
PUBLIC_API_BASE_URL=https://api.textzi.in

# --- Optional: Razorpay (wallet recharge via a real payment gateway) ---
# Leave unset to keep the dev-mode direct-credit recharge path. Use LIVE keys (not test keys)
# for a real production deployment.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# --- Optional: reverse proxy ---
# Only set to true if this API sits behind a reverse proxy/load balancer that itself sets (and
# overwrites, never passes through from the client) X-Forwarded-For -- otherwise a caller can
# spoof their own IP and defeat the API-key IP allow-list feature entirely.
TRUST_PROXY_HEADERS=false

# --- Optional: SMS send rate limiting (per calling entity) ---
SMS_RATE_LIMIT_MAX_REQUESTS=120
SMS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional: company/invoice detail fallbacks ---
# All of these are also editable from the admin UI (Platform Settings > General Setting), which
# takes priority whenever set -- these are only the fallback used until an admin configures them
# there. Usually easiest to just leave these unset and configure everything from the UI instead.
# COMPANY_NAME=
# COMPANY_ADDRESS=
# COMPANY_GSTIN=
# COMPANY_STATE=
# COMPANY_STATE_CODE=
# COMPANY_PHONE=
# SUPPORT_EMAIL=
